# Keep Docker build contexts small and avoid accidentally copying local artefacts.
#
# Services share the root build context so Keycloak and H5P can copy the
# canonical design tokens and locked font packages at build time.

# VCS
.git/

# Environment templates / secrets
.env
.env.*

# Python artefacts
**/__pycache__/
**/*.pyc
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node artefacts (defense-in-depth; also handled in `h5p-service/.dockerignore`)
**/node_modules/
frontend/build/
frontend/.svelte-kit/
frontend/dist/
frontend/*.tsbuildinfo
**/*.tgz
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*

# Temp / local-only runtime data
.tmp/
tmp/
supabase/storage/

# Backend test and harness code must not be copied into runtime images.
backend/tests/
backend/tests_e2e/
backend/tools/

# OS / editor
.DS_Store
.vscode/

.env
