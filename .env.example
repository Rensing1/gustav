# GUSTAV local environment example (do not commit secrets)

# App environment
GUSTAV_ENV=dev
GUSTAV_TRUST_PROXY=false  # set to true only when running behind a trusted reverse proxy

# Database DSNs — details in docs/references/config_matrix.md
# Security: use a login role IN ROLE `gustav_limited` (never log in as gustav_limited itself).
APP_DB_USER=gustav_app
APP_DB_PASSWORD=CHANGE_ME_DEV
DATABASE_URL=postgresql://${APP_DB_USER}:${APP_DB_PASSWORD}@127.0.0.1:54322/postgres
RLS_TEST_DSN=postgresql://${APP_DB_USER}:${APP_DB_PASSWORD}@127.0.0.1:54322/postgres
# Prod/Stage: TEACHING_DATABASE_URL / LEARNING_DATABASE_URL müssen explizit gesetzt werden (keine Fallbacks).

# Sessions (optional DB-backed)
# SESSIONS_BACKEND=db
# For docker-compose: the app container reaches Postgres via the Supabase DB service name.
# SESSION_DATABASE_URL=postgresql://postgres:postgres@supabase_db_gustav-alpha2:5432/postgres
# App session TTL (seconds) for cookie `gustav_session` + server-side session record.
# Default is 86400 (24h). Keep bounded to avoid accidental infinite sessions.
# Bounds (defense-in-depth): min 900 (15m), max 604800 (7d).
# APP_SESSION_TTL_SECONDS=86400

# OIDC / Keycloak (siehe docs/references/identity_access.md)
# Interne Services nutzen http://keycloak:8080, Browser verwenden KC_PUBLIC_BASE_URL (TLS, Proxy).
KC_BASE_URL=http://keycloak:8080
KC_PUBLIC_BASE_URL=https://id.localhost
KC_REALM=gustav
KC_ADMIN_REALM=master
KC_ADMIN_CLIENT_ID=gustav-admin-cli
KC_ADMIN_CLIENT_SECRET=CHANGE_ME_DEV
KC_HOSTNAME_URL=https://id.localhost
KC_HOSTNAME_ADMIN_URL=https://id.localhost
# Legacy fallback (nur lokal)
# KC_ADMIN_USERNAME=admin
# KC_ADMIN_PASSWORD=admin
# Keycloak DB (dev defaults — prod override mit sslmode=require etc.)
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://keycloak-db:5432/keycloak
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=keycloak
KC_DB_URL_PROPERTIES=sslmode=disable  # override with sslmode=require (and friends) in prod
# App base for browser-facing URLs (reverse proxy maps app.localhost → web)
WEB_BASE=https://app.localhost
REDIRECT_URI=https://app.localhost/auth/callback

# Keycloak SMTP / email sender (used for verification + password reset emails)
# Note: Do not commit real passwords; set KC_SMTP_PASSWORD only in your local `.env`.
# IMPORTANT: Replace the example host, user and from-address with real values before going to production.
KC_SMTP_HOST=smtp.school.example
KC_SMTP_PORT=587
KC_SMTP_USER=gustav-smtp-user
KC_SMTP_PASSWORD=
KC_SMTP_FROM=noreply@school.example
KC_SMTP_FROM_NAME=GUSTAV-Lernplattform
KC_SMTP_AUTH=true
KC_SMTP_STARTTLS=true

# Registration domain whitelist (optional, server-side pre-check for /auth/register login_hint).
# Comma-separated list of email domains, each starting with '@'.
# Example (default for GUSTAV at Gymnasium Alf): "@gymalf.de"
ALLOWED_REGISTRATION_DOMAINS=@gymalf.de

# Email verification enforcement for /auth/callback (currently disabled).
# GUSTAV vertraut auf Keycloak; das Flag wird nicht ausgewertet.
# EMAIL_VERIFICATION_REQUIRED=false

# Supabase Storage (self-hosted) — siehe docs/references/storage_and_gateway.md
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLIC_URL=https://app.localhost
SUPABASE_SERVICE_ROLE_KEY=DUMMY_DO_NOT_USE
# Security:
# - Service-Role-Key ist nur für Server; Prod bricht mit Dummy/leer sofort ab.
# - WICHTIG: nutze den JWT `SERVICE_ROLE_KEY` (beginnt mit `eyJ...`), nicht den
#   `SECRET_KEY`/`sb_secret_...` aus `supabase status`.
# - Lokal nach `supabase start` oder `supabase db reset` einfach:
#     `make supabase-sync-env`
#   (aktualisiert `SUPABASE_URL` + `SUPABASE_SERVICE_ROLE_KEY` in deiner `.env`).
SUPABASE_STORAGE_BUCKET=materials
LEARNING_STORAGE_BUCKET=submissions
# Centralized size limits (bytes)
MATERIALS_MAX_UPLOAD_BYTES=20971520
LEARNING_MAX_UPLOAD_BYTES=10485760
# Dev-Only Convenience (siehe docs/ARCHITECTURE.md#storage-bootstrap-nur-devci)
AUTO_CREATE_STORAGE_BUCKETS=false

# H5P (teacher review)
# Used to sign/verify short-lived, teacher-only review tokens for embedding the
# read-only H5P player in the Live matrix detail pane.
H5P_REVIEW_TOKEN_SECRET=CHANGE_ME_DEV
# H5P debug HTML pages (`/h5p/editor`, `/h5p/player`)
# - Admin-only, but contain inline scripts (CSP exception).
# - Defense-in-depth: in prod/stage these pages are always disabled (404),
#   independent of this flag.
# - In dev/test you can disable them explicitly to reduce surface.
H5P_ENABLE_DEBUG_PAGES=true

# Notes:
# - Keep this file as a template. Create a real `.env` with your secrets.
# - The backend loads `.env` automatically in dev/test.

# Local AI (siehe docs/references/learning_ai.md)
AI_BACKEND=local
OLLAMA_BASE_URL=http://ollama:11434
AI_VISION_MODEL=qwen2.5vl:3b
# Optional override for `Task.kind=visual` (falls back to AI_VISION_MODEL when unset)
AI_VISUAL_MODEL=
AI_FEEDBACK_MODEL=gpt-oss:latest
AI_THINK_LEVEL=low
AI_TIMEOUT_VISION=30
AI_TIMEOUT_FEEDBACK=15
# DSPy JSONAdapter (true = strikt). Compose injiziert den Wert automatisch in den Worker.
# Logs: `docker compose logs -n 50 learning-worker | rg dspy_configured`.
LEARNING_DSPY_JSON_ADAPTER=true

# Learning worker dev helper: ignore queue jobs created by in-process pytest runs.
# Prevents flaky tests when a local docker `learning-worker` consumes jobs concurrently.
WORKER_SKIP_PYTEST_JOBS=true
