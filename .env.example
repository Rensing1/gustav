# GUSTAV local environment example (do not commit secrets)

# App environment
GUSTAV_ENV=dev
GUSTAV_TRUST_PROXY=false  # set to true only when running behind a trusted reverse proxy

# Database DSNs — details in docs/references/config_matrix.md
# Security: use a login role IN ROLE `gustav_limited` (never log in as gustav_limited itself).
APP_DB_USER=gustav_app
APP_DB_PASSWORD=CHANGE_ME_DEV
DATABASE_URL=postgresql://${APP_DB_USER}:${APP_DB_PASSWORD}@127.0.0.1:54322/postgres
RLS_TEST_DSN=postgresql://${APP_DB_USER}:${APP_DB_PASSWORD}@127.0.0.1:54322/postgres
LEARNING_DATABASE_URL=postgresql://${APP_DB_USER}:${APP_DB_PASSWORD}@127.0.0.1:54322/postgres
LEARNING_WORKER_DB_USER=gustav_worker
LEARNING_WORKER_DB_PASSWORD=CHANGE_ME_DEV
LEARNING_WORKER_DATABASE_URL=postgresql://${LEARNING_WORKER_DB_USER}:${LEARNING_WORKER_DB_PASSWORD}@127.0.0.1:54322/postgres
# Prod/Stage: TEACHING_DATABASE_URL / LEARNING_DATABASE_URL müssen explizit gesetzt werden (keine Fallbacks).

# Sessions (optional DB-backed)
# SESSIONS_BACKEND=db
# For docker-compose: the app container reaches Postgres via the Supabase DB service name.
# SESSION_DATABASE_URL=postgresql://postgres:postgres@supabase_db_gustav-alpha2:5432/postgres
# App session TTL (seconds) for cookie `gustav_session` + server-side session record.
# Default is 86400 (24h). Keep bounded to avoid accidental infinite sessions.
# Bounds (defense-in-depth): min 900 (15m), max 604800 (7d).
# APP_SESSION_TTL_SECONDS=86400

# OIDC / Keycloak (siehe docs/references/identity_access.md)
# Interne Services nutzen http://keycloak:8080, Browser verwenden KC_PUBLIC_BASE_URL (TLS, Proxy).
KC_BASE_URL=http://keycloak:8080
KC_PUBLIC_BASE_URL=https://id.localhost
KC_REALM=gustav
KC_ADMIN_REALM=master
KC_ADMIN_CLIENT_ID=gustav-admin-cli
KC_ADMIN_CLIENT_SECRET=CHANGE_ME_DEV
# Optional fallback client for role-members endpoint retries (403 hardening).
# Uses client_credentials only; password-grant fallback is intentionally disabled.
# KC_ADMIN_FALLBACK_REALM=master
# KC_ADMIN_FALLBACK_CLIENT_ID=admin-cli
# KC_ADMIN_FALLBACK_CLIENT_SECRET=CHANGE_ME_DEV
KC_HOSTNAME_URL=https://id.localhost
KC_HOSTNAME_ADMIN_URL=https://id.localhost
# Legacy fallback (nur lokal)
# KC_ADMIN_USERNAME=admin
# KC_ADMIN_PASSWORD=admin
# Keycloak DB (dev defaults — prod override mit sslmode=require etc.)
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://keycloak-db:5432/keycloak
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=keycloak
KC_DB_URL_PROPERTIES=sslmode=disable  # override with sslmode=require (and friends) in prod
# App base for browser-facing URLs (reverse proxy maps app.localhost → web)
WEB_BASE=https://app.localhost
REDIRECT_URI=https://app.localhost/auth/callback
# Frontend BFF session signing secret (Node service, HttpOnly flow cookies)
FRONTEND_SESSION_SECRET=CHANGE_ME_DEV
# Shared secret between SvelteKit and FastAPI for `/backend-internal/app/bff-session`
BFF_INTERNAL_SHARED_SECRET=CHANGE_ME_DEV
# Shared cookie name used by the Browser-BFF and H5P sidecar.
FRONTEND_SESSION_COOKIE_NAME=gustav_bff_session
# Browser-BFF session TTL (seconds). Defaults to APP_SESSION_TTL_SECONDS.
# Keep consistent with the app session unless you have a clear reason to diverge.
# BFF_SESSION_TTL_SECONDS=86400

# Keycloak SMTP / email sender (used for verification + password reset emails)
# Note: Do not commit real passwords; set KC_SMTP_PASSWORD only in your local `.env`.
# IMPORTANT: Replace the example host, user and from-address with real values before going to production.
KC_SMTP_HOST=smtp.school.example
KC_SMTP_PORT=587
KC_SMTP_USER=gustav-smtp-user
KC_SMTP_PASSWORD=
KC_SMTP_FROM=noreply@school.example
KC_SMTP_FROM_NAME=GUSTAV-Lernplattform
KC_SMTP_AUTH=true
KC_SMTP_STARTTLS=true

# Registration domain whitelist (optional, server-side pre-check for /auth/register login_hint).
# Comma-separated list of email domains, each starting with '@'.
# Example: "@school.example"
ALLOWED_REGISTRATION_DOMAINS=@school.example

# Email verification enforcement for /auth/callback (currently disabled).
# GUSTAV vertraut auf Keycloak; das Flag wird nicht ausgewertet.
# EMAIL_VERIFICATION_REQUIRED=false

# Supabase Storage (self-hosted) — siehe docs/references/storage_and_gateway.md
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLIC_URL=https://app.localhost
SUPABASE_SERVICE_ROLE_KEY=DUMMY_DO_NOT_USE
# Security:
# - Service-Role-Key ist nur für Server; Prod bricht mit Dummy/leer sofort ab.
# - WICHTIG: nutze den JWT `SERVICE_ROLE_KEY` (beginnt mit `eyJ...`), nicht den
#   `SECRET_KEY`/`sb_secret_...` aus `supabase status`.
# - Lokal nach `supabase start` oder `supabase db reset`:
#   - `supabase status` ausführen und `SUPABASE_URL` + `SUPABASE_SERVICE_ROLE_KEY`
#     in deiner `.env` aktualisieren.
SUPABASE_STORAGE_BUCKET=materials
LEARNING_STORAGE_BUCKET=submissions
# Centralized size limits (bytes)
MATERIALS_MAX_UPLOAD_BYTES=20971520
LEARNING_MAX_UPLOAD_BYTES=10485760
# Dev-Only Convenience (siehe docs/ARCHITECTURE.md#storage-bootstrap-nur-devci)
AUTO_CREATE_STORAGE_BUCKETS=false

# H5P (teacher review)
# Used to sign/verify short-lived, teacher-only review tokens for embedding the
# read-only H5P player in the Live matrix detail pane.
H5P_REVIEW_TOKEN_SECRET=CHANGE_ME_DEV
# SSR form CSRF token signing (recommended explicit key, otherwise H5P secret is reused)
APP_CSRF_TOKEN_SECRET=CHANGE_ME_DEV
# Optional override (seconds). Defaults to APP_SESSION_TTL_SECONDS; clamped to 60..604800.
# APP_CSRF_TTL_SECONDS=86400
# H5P debug HTML pages (`/h5p/editor`, `/h5p/player`)
# - Admin-only, but contain inline scripts (CSP exception).
# - Defense-in-depth: in prod/stage these pages are always disabled (404),
#   independent of this flag.
# - In dev/test you can disable them explicitly to reduce surface.
H5P_ENABLE_DEBUG_PAGES=true

# Members UI: cache enrolled sub identifiers for search filtering (seconds, clamped to 1..300)
# MEMBERS_SEARCH_SUBS_CACHE_TTL_SECONDS=30.0
# Members UI: max in-memory cache entries for enrolled sub identifiers (clamped to 1..5000)
# MEMBERS_SEARCH_SUBS_CACHE_MAX_ENTRIES=512
# Directory login-label scan guardrails (student role members endpoint):
# DIRECTORY_LOGIN_LABEL_MAX_SUBS=200
# DIRECTORY_LOGIN_LABEL_BATCH_SIZE=200
# DIRECTORY_LOGIN_LABEL_SCAN_CAP=4000

# Notes:
# - Keep this file as a template. Create a real `.env` with your secrets.
# - The backend loads `.env` automatically in dev/test.

# Learning AI (DSPy-only via OpenAI-compatible endpoint; siehe docs/references/learning_ai.md)
#
# Contract:
# - OPENAI_BASE_URL is used as-is (no path rules, no implicit "/v1").
#   Example (Open-WebUI proxy): http://host.docker.internal:8111/api/v1
# - Model names are provided by the operator (text, OCR, visual).
OPENAI_BASE_URL=http://host.docker.internal:8111/api/v1
OPENAI_API_KEY=
AI_TEXT_MODEL=your-text-model
AI_OCR_MODEL=your-ocr-model
AI_VISUAL_MODEL=your-visual-model
AI_TEXT_TEMPERATURE=0.0
AI_TEXT_ANALYSIS_TEMPERATURE=
AI_TEXT_SYNTHESIS_TEMPERATURE=
AI_TEXT_REASONING_EFFORT=
AI_TEXT_ANALYSIS_REASONING_EFFORT=
AI_TEXT_SYNTHESIS_REASONING_EFFORT=
AI_OCR_TEMPERATURE=0.0
AI_VISUAL_TEMPERATURE=0.0
AI_VISUAL_ANALYSIS_TEMPERATURE=
AI_VISUAL_SYNTHESIS_TEMPERATURE=
AI_VISUAL_REASONING_EFFORT=
AI_VISUAL_ANALYSIS_REASONING_EFFORT=
AI_VISUAL_SYNTHESIS_REASONING_EFFORT=

# Optional: GPT-OSS think-level (only applied when the model leaf starts with "gpt-oss").
# Allowed: low|medium|high. Stage-specific values override the shared text/visual defaults.
# AI_TEXT_THINK_LEVEL=low
# AI_TEXT_ANALYSIS_THINK_LEVEL=low
# AI_TEXT_SYNTHESIS_THINK_LEVEL=low
# AI_OCR_THINK_LEVEL=low
# AI_VISUAL_THINK_LEVEL=low
# AI_VISUAL_ANALYSIS_THINK_LEVEL=low
# AI_VISUAL_SYNTHESIS_THINK_LEVEL=low

# Optional: Mistral reasoning effort (only applied when the model leaf starts with "mistral").
# Allowed: none|high. Stage-specific values override the shared text/visual defaults.
# AI_TEXT_REASONING_EFFORT=none
# AI_TEXT_ANALYSIS_REASONING_EFFORT=none
# AI_TEXT_SYNTHESIS_REASONING_EFFORT=none
# AI_VISUAL_REASONING_EFFORT=none
# AI_VISUAL_ANALYSIS_REASONING_EFFORT=none
# AI_VISUAL_SYNTHESIS_REASONING_EFFORT=none

# Optional DI overrides (mostly useful for tests/experiments)
# LEARNING_VISION_ADAPTER=backend.learning.adapters.local_vision
# LEARNING_FEEDBACK_ADAPTER=backend.learning.adapters.local_feedback

# Learning worker dev helper: ignore queue jobs created by in-process pytest runs.
# Prevents flaky tests when a local docker `learning-worker` consumes jobs concurrently.
WORKER_SKIP_PYTEST_JOBS=true
