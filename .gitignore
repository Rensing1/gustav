# Dokumentationen (Repo-weit versioniert)
# Hinweis: Einzelne Build-Artefakte ggf. gezielt ausschließen, aber nicht den gesamten Ordner.
# Python bytecode cache
__pycache__/
*.pyc
.venv/
.env*
!.env.example
.envrc
.direnv/
secrets/
.secrets/
.keys/
*.pem
*.key
*.p12
*.pfx
.pgpass
.pg_service.conf
.pg_service
.pgpass.conf
.vscode/
.DS_Store
*.swp
# Do not commit DB dumps or archives
docs/migration/*.tar
docs/migration/*.tar.gz
docs/migration/*.dump
docs/migration/reports/
docs/migration/.tmp/
.tmp/
tmp/
docs/migration/tmp/
docs/migration/storage_raw/

# Supabase bind-mount storage (runtime data; must not be committed)
supabase/storage/h5p/**
!supabase/storage/h5p/.gitkeep

# Backup files
*.bak

# Node (H5P service)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tgz
