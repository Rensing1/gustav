{
  "name": "gustav-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 3000",
    "build": "svelte-kit sync && bash tooling/build-with-warning-gate.sh",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run && node --test tooling/build-output-policy.test.mjs tooling/css-compatibility.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.7",
    "@fontsource/manrope": "^5.2.7",
    "@fontsource/nunito": "^5.2.7",
    "@fontsource/space-grotesk": "^5.2.10",
    "@fontsource/work-sans": "^5.2.7",
    "@tiptap/core": "3.28.0",
    "@tiptap/extension-placeholder": "3.28.0",
    "@tiptap/extension-table": "3.28.0",
    "@tiptap/markdown": "3.28.0",
    "@tiptap/pm": "3.28.0",
    "@tiptap/starter-kit": "3.28.0",
    "@xyflow/svelte": "1.6.2",
    "elkjs": "^0.11.0",
    "isomorphic-dompurify": "3.19.0",
    "jose": "6.2.3",
    "markdown-it": "14.3.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/kit": "2.70.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/svelte": "^5.2.8",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "jsdom": "^26.1.0",
    "postcss": "8.5.19",
    "svelte": "5.56.6",
    "svelte-check": "^4.1.1",
    "typescript": "^5.7.3",
    "vite": "6.4.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "cookie": "0.7.2"
  }
}
