(app_proxy) {
  @api_path path /api/* /internal/* /health
  handle @api_path {
    reverse_proxy gustav-alpha2:8000
  }

  # Path-based routing for the self-hosted H5P service (same origin).
  # NOTE: `handle_path` strips the `/h5p` prefix before proxying.
  # The H5P service still uses `baseUrl=/h5p` so browser URLs stay stable.
  handle_path /h5p/* {
    reverse_proxy h5p:3000
  }
  # Same-origin path proxy for Supabase Storage (dev = prod)
  @storage_path path /storage/v1/*
  handle @storage_path {
    # Kong routes often match on Host; set upstream Host to the public
    # supabase host to ensure the route is found, while keeping the
    # browser-facing origin on the app domain (same-origin).
    reverse_proxy {
      to supabase_kong_gustav-alpha2:8000
      header_up Host supabase.localhost
    }
  }

  # Default app backend is the SvelteKit Browser-BFF.
  reverse_proxy gustav-frontend:3000
}

# Local development (internal CA)
app.localhost:443 {
  tls internal
  import app_proxy
}

localhost:443 {
  tls internal
  reverse_proxy gustav-alpha2:8000
}

id.localhost:443 {
  tls internal
  reverse_proxy keycloak:8080 {
    # Keycloak 24 does not add all cookie flags on detached error flows.
    # The IdP is always served over HTTPS here, so enforce the GUSTAV cookie floor at the proxy boundary.
    header_down Set-Cookie "^(.*)$" "$1; Secure; SameSite=Lax"
  }
}

# Public Supabase gateway for browser access to Storage API (dev = prod)
supabase.localhost:443 {
  tls internal
  reverse_proxy supabase_kong_gustav-alpha2:8000
}
